---
import '../../../styles/global.css';

const next = Astro.url.searchParams.get('next') ?? '/studio/admin';
const safeNext = next.startsWith('/') ? next : '/studio/admin';
const error = Astro.url.searchParams.get('error') ?? '';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <title>Studio Admin Login - Gabriel Cozma</title>
  <meta name="description" content="Authenticated access for Studio admin." />
</head>
<body>
  <main class="container mx-auto max-w-140 px-4 pt-20 pb-16 flex flex-col items-center font-serif">
    <div class="w-full max-w-md border border-gray-900/10 dark:border-white/10 p-8">
      <p class="text-[10px] font-mono uppercase tracking-[0.25em] opacity-45 mb-3">Studio Control</p>
      <h1 class="text-4xl italic font-light mb-3">Owner Sign In</h1>
      <p class="text-sm opacity-60 mb-8 font-light">Authenticate to manage commissions and payment flow.</p>

      {error === 'invalid_credentials' && (
        <p class="text-sm mb-5 text-[#A34D32]">Invalid credentials. Try again.</p>
      )}

      <form action="/api/studio/auth/login" method="post" class="flex flex-col gap-5">
        <input type="hidden" name="next" value={safeNext} />

        <label class="flex flex-col gap-2">
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] opacity-55">Username</span>
          <input
            type="text"
            name="username"
            required
            autocomplete="username"
            class="w-full border border-gray-900/15 dark:border-white/20 bg-transparent px-3 py-2.5 text-sm font-sans"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] opacity-55">Password</span>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            class="w-full border border-gray-900/15 dark:border-white/20 bg-transparent px-3 py-2.5 text-sm font-sans"
          />
        </label>

        <button
          type="submit"
          class="mt-2 inline-flex items-center justify-center px-5 py-3 bg-[#1A1A1A] text-[#FDFDFB] border border-[#1A1A1A] text-sm italic transition-colors hover:bg-[#A34D32] hover:border-[#A34D32] dark:bg-[#FDFDFB] dark:text-[#1A1A1A] dark:border-[#FDFDFB]"
        >
          Sign in
        </button>
      </form>

      <a href="/studio" class="micro-link mt-6 inline-block text-xs uppercase tracking-[0.2em] opacity-50 hover:opacity-100">Back to Studio</a>
    </div>
  </main>

  <style>
    .micro-link { position:relative; text-decoration:none; }
    .micro-link::after {
      content:""; position:absolute; left:0; bottom:-0.08em;
      width:100%; height:1px; background:currentColor;
      transform:scaleX(0); transform-origin:left;
      transition:transform 260ms cubic-bezier(0.19,1,0.22,1);
    }
    .micro-link:hover::after,
    .micro-link:focus-visible::after { transform:scaleX(1); }
  </style>
</body>
</html>

