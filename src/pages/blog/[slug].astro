---
import { readFile } from "node:fs/promises";
import path from "node:path";
import matter from "gray-matter";
import { marked } from "marked";
import BlogHeader from "../../components/BlogHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

type BlogFrontmatter = {
  title?: string;
  date?: string | Date;
  tags?: string[];
  draft?: boolean;
};

export async function getStaticPaths() {
  const postModules = import.meta.glob("../../content/blog/*.md");

  return Object.keys(postModules).map((filePath) => ({
    params: { slug: filePath.split("/").pop()?.replace(/\.md$/, "") ?? "" }
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("Missing slug.");

const filePath = path.join(process.cwd(), "src/content/blog", `${slug}.md`);
const source = await readFile(filePath, "utf-8");
const { data, content } = matter(source);
const frontmatter = data as BlogFrontmatter;

if (frontmatter.draft) return Astro.redirect("/blog");

const postTitle = frontmatter.title ?? slug;
const postDate = frontmatter.date ? new Date(frontmatter.date) : new Date();
const postTags = frontmatter.tags ?? [];
const postHtml = await marked.parse(content);

const postDescription = content
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/`[^`]*`/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim()
  .slice(0, 180);

const ogImagePath = `/og/blog/${slug}.png`;
const postUrl = `/blog/${slug}/`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric"
  }).format(date);
---

<SiteLayout
  title={`${postTitle} | Blog`}
  description={postDescription}
  image={ogImagePath}
  url={postUrl}
  type="article"
  publishedTime={postDate.toISOString()}
>
  <main class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-16 px-4 py-10 font-serif sm:px-6 lg:py-16">
    <BlogHeader />

    <article class="mx-auto flex w-full max-w-3xl flex-col gap-12">
      <div class="flex flex-col gap-12">
        <div class="flex flex-row gap-3 font-extralight justify-between">
          <p>{formatDate(postDate)}</p>
          <p class="sm:text-right font-serif">{postTags.join(" · ")}</p>
        </div>

        <h1 class="text-center text-4xl italic">{postTitle}</h1>
        <hr class="border-t border-b border-neutral-100 dark:border-neutral-800 w-full" />
      </div>

      <div class="prose prose-p:font-sans font-normal dark:prose-invert dark:text-white prose-neutral max-w-none text-[1.125rem] leading-8 prose-headings:italic prose-headings:font-extrabold prose-hedings:font-serif prose-a:italic prose-a:underline prose-blockquote:italic prose-blockquote:border-l prose-blockquote:border-gray-200 prose-pre:border prose-blockquote:font-serif prose-pre:border-gray-100 prose-pre:dark:border-zinc-700 prose-img:rounded-xl prose-figcaption:text-center prose-figcaption:text-sm prose-img:grayscale prose-img:transition-all prose-img:hover:grayscale-0 prose-a:font-serif" set:html={postHtml}></div>

      <div class="flex w-full items-center justify-end">
        <p class="font-extralight">~by <b class="font-extrabold italic">Gabs</b></p>
      </div>
    </article>
  </main>
</SiteLayout>
