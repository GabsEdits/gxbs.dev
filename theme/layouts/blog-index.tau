<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    {@include "Head"}
    <link rel="alternate" type="application/rss+xml" title="Gabriel Cozma" href="/feed.xml" />
  </head>
  <body class="post-page">
    <SkipLink />
    {@include "TimeOfDayBackground"}
    <main id="main-content" tabindex="-1" class="viewport post-viewport">
      <div class="left-content post-content">
        <a class="back-link" href="/">← Home</a>
        <div class="post-header">
          <h1>Blog</h1>
          {@html content}
        </div>
        <ul class="post-list">
          {#each collections.blog.items as post}
            {#if !post.frontmatter.archived}
              <li class="post-list-item">
                <a href="{post.url | url}">{post.frontmatter.title}</a>
                <time>{post.frontmatter.displayDate}</time>
              </li>
            {/if}
          {:else}
            <li class="post-list-empty">No posts yet.</li>
          {/each}
        </ul>
      </div>
    </main>
    <Footer />
  </body>
</html>
