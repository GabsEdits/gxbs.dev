<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{title} — Gabriel Cozma</title>
    <meta name="description" content="{description}" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{title}" />
    <meta property="og:description" content="{description}" />
    <meta property="og:url" content="{canonical | url}" />
    <meta property="og:image" content="{image | url}" />
    <link rel="canonical" href="{canonical | url}" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="/assets/tailwind.css" />
  </head>
  <body>
    <main class="mx-auto flex min-h-screen w-full max-w-full flex-col gap-16 px-4 py-10 font-serif sm:px-6 lg:max-w-160 lg:py-24">
      <BlogHeader />
      <article class="mx-auto flex w-full flex-col gap-12">
        <div class="flex flex-col items-center gap-6 text-center">
          <p class="font-sans text-sm font-normal opacity-70">{displayDate} · {#each tags as tag}<span>{tag} </span>{/each}</p>
          <h1 class="text-4xl italic sm:text-5xl">{title}</h1>
          <hr class="divider w-full" />
        </div>
        <div class="prose-article">{@html content}</div>
        <hr class="divider w-full" />
        <div class="flex w-full items-center justify-between">
          <a href="/blog" class="micro-link text-lg">← Blog</a>
          <p class="font-sans text-sm font-normal opacity-70">~by <b class="font-serif text-lg font-extrabold italic">Gabs</b></p>
        </div>
      </article>
      <Footer />
    </main>
  </body>
</html>
