<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Blog</title>
    <meta name="description" content="{description}" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="{canonical | url}" />
    <meta property="og:image" content="{image | url}" />
    <link rel="canonical" href="{canonical | url}" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/tailwind.css" />
  </head>
  <body>
    <main class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-16 px-4 py-10 font-serif sm:px-6 lg:py-16">
      <BlogHeader />
      <article class="mx-auto flex w-full max-w-3xl flex-col gap-12">
        <div class="flex flex-col items-center gap-6 text-center">
          <p class="font-sans text-sm font-normal opacity-70">{displayDate} · {#each tags as tag}<span>{tag} </span>{/each}</p>
          <h1 class="text-4xl italic sm:text-5xl">{title}</h1>
          <hr class="divider w-full" />
        </div>
        <div class="max-w-none text-[1.125rem] leading-8 font-normal dark:text-white [&_p]:my-5 [&_p]:font-sans [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-3xl [&_h2]:font-extrabold [&_h2]:italic [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-2xl [&_h3]:font-extrabold [&_h3]:italic [&_a]:font-serif [&_a]:italic [&_a]:underline [&_blockquote]:my-6 [&_blockquote]:border-l [&_blockquote]:border-gray-200 [&_blockquote]:pl-5 [&_blockquote]:font-serif [&_blockquote]:italic dark:[&_blockquote]:border-zinc-700 [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-gray-100 [&_pre]:p-4 dark:[&_pre]:border-zinc-700 [&_img]:my-7 [&_img]:rounded-xl [&_img]:grayscale [&_img]:transition-all hover:[&_img]:grayscale-0">{@html content}</div>
        <hr class="divider w-full" />
        <div class="flex w-full items-center justify-between">
          <a href="/blog" class="micro-link text-lg">← Blog</a>
          <p class="font-sans text-sm font-normal opacity-70">~by <b class="font-serif text-lg font-extrabold italic">Gabs</b></p>
        </div>
      </article>
      <Footer />
    </main>
  </body>
</html>
