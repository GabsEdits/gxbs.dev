<!doctype html>
<html lang="en">
  <head>
    <title>{title} — Gabriel Cozma</title>
    {@include "Head"}
    <meta property="og:type" content="article" />
    <meta property="og:image" content="{image | url}" />
  </head>
  <body class="post-page">
    <SkipLink />
    {@include "TimeOfDayBackground"}
    <main id="main-content" tabindex="-1" class="viewport post-viewport">
      <article class="post-shell">
        <header class="post-aside">
          <a class="back-link" href="/blog">← All posts</a>
          <h1>{title}</h1>
          <div class="post-aside-meta">
            {#if displayDate}<time>{displayDate}</time>{/if}
            {#if tags}
              <div class="post-tags">{#each tags as tag}<span class="tag">{tag}</span>{/each}</div>
            {/if}
          </div>
        </header>
        <div class="left-content post-content">
          <article class="post-body">{@html content}</article>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
