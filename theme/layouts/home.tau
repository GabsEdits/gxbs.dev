  <path
    d="M220.408 0C257.737 0 288 30.2205 288 67.4995C288 104.779 257.738 135 220.408 135C212.028 135 204.005 133.476 196.6 130.692C214.738 115.619 226.286 92.9063 226.286 67.4995C226.286 42.0926 214.738 19.3794 196.6 4.30616C204.005 1.52265 212.028 4.32962e-05 220.408 0Z"
