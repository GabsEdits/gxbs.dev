    fill="currentColor"
  />
</svg>

        <div class="hero-heading">
          <h1>
            <span id="greeting-prefix">Good Evening, I'm</span>
            <span id="name-anchor"
              ><span class="carousel-text" id="main-name">Gabriel Cozma</span></span
            >
          </h1>
        </div>

        <nav class="home-links" aria-label="Contact and writing">
          <a href="mailto:me@gxbs.dev" aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 4a2 2 0 0 0-2 2v.5l10 6.25L22 6.5V6a2 2 0 0 0-2-2H4Zm18 4.27-9.6 6a.75.75 0 0 1-.8 0L2 8.27V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8.27Z" />
            </svg>
          </a>
          <a href="https://github.com/GabsEdits" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.01-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.69.11 2.98.72.78 1.16 1.78 1.16 3.01 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
            </svg>
          </a>
          <a href="/posts">
<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="currentColor" viewBox="0 0 256 256"><path d="M227.32,73.37,182.63,28.69a16,16,0,0,0-22.63,0L36.69,152A15.86,15.86,0,0,0,32,163.31V208a16,16,0,0,0,16,16H216a8,8,0,0,0,0-16H115.32l112-112A16,16,0,0,0,227.32,73.37ZM192,108.69,147.32,64l24-24L216,84.69Z"></path></svg>            Blog
