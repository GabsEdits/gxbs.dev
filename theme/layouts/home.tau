<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
  {@include "Head"}
    <script src="/assets/{assets?.['home.js']}" defer></script>
  </head>
  <body class="home-page">
    <SkipLink />
    {@include "TimeOfDayBackground"}

    <main class="viewport home-viewport">
      <div class="left-content">
        <header class="home-hero">
<svg
  class="brand-symbol"
  width="33.6"
  height="15.75"
  viewBox="0 0 288 135"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; overflow: visible;"
>
  <path
    d="M67.5913 0C75.9707 0 83.9942 1.52276 91.3989 4.30616C73.2609 19.3794 61.7145 42.0928 61.7143 67.4995C61.7143 92.9061 73.2612 115.619 91.3989 130.692C83.994 133.476 75.9709 135 67.5913 135C30.2616 135 0 104.779 0 67.4995C0.000193118 30.2207 30.2618 0.000192881 67.5913 0Z"
    fill="currentColor"
