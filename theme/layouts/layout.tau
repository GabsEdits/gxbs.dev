<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="{description}" />
    <link rel="canonical" href="{canonical | url}" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/tailwind.css" />
  </head>
  <body>
    <main class="mx-auto min-h-screen w-full max-w-3xl px-4 py-12 font-serif sm:px-6">
      <a class="mb-12 inline-block text-sm underline" href="/">← Home</a>
      <article class="text-[1.125rem] leading-8 [&_p]:my-5 [&_p]:font-sans [&_h1]:mb-8 [&_h1]:text-4xl [&_h1]:italic [&_h2]:mt-10 [&_h2]:text-3xl [&_a]:italic [&_a]:underline">{@html content}</article>
    </main>
    <Footer />
  </body>
</html>
